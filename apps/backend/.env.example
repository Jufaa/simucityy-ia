# Backend configuration — copy to .env in this same directory (apps/backend/)
# Never commit the real .env.

HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# BYOK: master key to encrypt users' Meta API keys (32 bytes = 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BYOK_MASTER_KEY=

# Optional: global Meta API key used as fallback (demo mode)
# META_API_KEY=LLM_...
# BYOK key storage stays disabled unless explicitly enabled. This API has
# no authentication, so never enable it on a public deployment: a
# caller-supplied userId alone would authorize key use and management.
# BYOK_ENABLED=false
