
{
  "$schema": "https://opencode.ai/config.json",
  "model": "meta/muse-wonder-1.0",
  "provider": {
    "meta": {
      "npm": "@ai-sdk/openai",
      "name": "Meta Model API",
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:MODEL_API_KEY}"
      },
      "models": {
        "muse-wonder-1.0": {
          "name": "Muse Wonder",
          "reasoning": true,
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        }
      }
    }
  }
}
