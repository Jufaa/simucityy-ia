{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "HOST",
        "PORT",
        "WEB_PORT",
        "LOG_LEVEL",
        "CORS_ORIGINS",
        "API_URL"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_URL"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@simulicity/shared#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  },
  "globalDependencies": [".env"]
}
