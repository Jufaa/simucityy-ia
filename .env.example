# Copy to .env at the repository root. No database or Meta credentials needed for pnpm dev.
HOST=127.0.0.1
PORT=4000
WEB_PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_INITIAL_LONGITUDE=-80.1918
NEXT_PUBLIC_INITIAL_LATITUDE=25.7617
# Optional database. Pick a local password and use the same value in DATABASE_URL.
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://simulicity:YOUR_LOCAL_PASSWORD@localhost:5433/simulicity?schema=public
# Reserved, server-only. The provider intentionally makes no network requests yet.
# META_API_KEY=
